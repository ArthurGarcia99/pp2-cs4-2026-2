{
  "name": "PP2 Full Stack — Node.js 24",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "GitHub.codespaces"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ]
      }
    }
  },
  "forwardPorts": [
    8888,
    5173
  ],
  "portsAttributes": {
    "8888": {
      "label": "Back-end",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Front-end (Vite)",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode"
}
